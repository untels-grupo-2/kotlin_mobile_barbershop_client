<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupActualizarUsuarioLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    android:elevation="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACTUALIZAR PERFIL"
        android:textColor="#FF9800"
        android:fontFamily="@font/oswald_font"
        android:textSize="18sp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etNombreUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre"
        android:inputType="textPersonName"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="10dp"
        android:padding="10dp"
        android:background="@drawable/borde_naranja"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etApellidoUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Apellido"
        android:inputType="textPersonName"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="10dp"
        android:padding="10dp"
        android:background="@drawable/borde_naranja"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etEmailUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:drawableStart="@android:drawable/ic_menu_info_details"
        android:drawablePadding="10dp"
        android:padding="10dp"
        android:textColorHint="#888888"
        android:background="@drawable/borde_naranja"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etCelularUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Celular"
        android:inputType="phone"
        android:drawableStart="@android:drawable/ic_menu_call"
        android:drawablePadding="10dp"
        android:padding="10dp"
        android:textColorHint="#888888"
        android:background="@drawable/borde_naranja"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnSeleccionarImagenUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECCIONAR IMAGEN"
        android:backgroundTint="#1E1E1E"
        android:textColor="#FF9800"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutImagenSeleccionada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/borde_naranja"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Archivo:"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tvImagenSeleccionada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:textColor="#FF9800"
            android:textSize="11sp"
            android:fontFamily="@font/oswald_font"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <Button
        android:id="@+id/btnActualizarUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ACTUALIZAR USUARIO"
        android:textColor="#000000"
        android:backgroundTint="#FF9800"
        android:fontFamily="@font/oswald_font"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCancelarActualizarUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR"
        android:backgroundTint="#2A2A2A"
        android:textColor="#888888"
        android:fontFamily="@font/oswald_font" />

</LinearLayout>
