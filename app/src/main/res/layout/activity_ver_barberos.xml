<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ──── Toolbar ──── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A1A1A"
            android:title="SELECCIONAR BARBERO"
            android:titleTextColor="#FF9800"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
            app:navigationIconTint="#FF9800"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ──── ProgressBar centrado ──── -->
    <ProgressBar
        android:id="@+id/progressBarBarberos"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#FF9800"
        android:visibility="gone" />

    <!-- ──── Botones fijos al fondo ──── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#121212"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReservar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#FF9800"
            android:fontFamily="@font/oswald_font"
            android:text="SIGUIENTE"
            android:textColor="#000000"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E1E1E"
            android:fontFamily="@font/oswald_font"
            android:text="CANCELAR"
            android:textColor="#777777"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- ──── Contenido con scroll ──── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="148dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- ──── Imagen del servicio enmarcada ──── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#1E1E1E">

                <ImageView
                    android:id="@+id/imagenServicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/barberia1"
                    android:scaleType="centerCrop"
                    android:background="#1E1E1E"
                    android:contentDescription="Imagen del servicio" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ──── Card información del servicio ──── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#FF9800"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:gravity="center">

                    <!-- Nombre del servicio -->
                    <TextView
                        android:id="@+id/textTituloServicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald_font"
                        android:text="Nombre del Servicio"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <!-- Badge precio — fondo naranja sólido -->
                    <TextView
                        android:id="@+id/textPrecioServicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/oswald_font"
                        android:background="@drawable/bg_precio_badge"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="S/ 0.0"
                        android:textSize="17sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <!-- Línea separadora naranja -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:background="#FF9800" />

                    <!-- Descripción -->
                    <TextView
                        android:id="@+id/textDescripcionServicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald_font"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Sede -->
                    <TextView
                        android:id="@+id/textSedeServicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/oswald_font"
                        android:text="SEDE: VILLA MARIA"
                        android:textSize="12sp"
                        android:textColor="#FF9800"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.1" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ──── Header sección barberos ──── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="#FF9800" />

                <TextView
                    android:id="@+id/textElegirBarbero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/oswald_font"
                    android:text="  ELEGIR BARBERO  "
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"
                    android:letterSpacing="0.15" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="#FF9800" />

            </LinearLayout>

            <!-- ──── Lista de barberos ──── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewBarberos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
