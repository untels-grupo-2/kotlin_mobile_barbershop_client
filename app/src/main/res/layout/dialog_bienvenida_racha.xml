<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:gravity="center"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:strokeColor="#FF9800"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <!-- Badge de racha (cambia según nivel) -->
            <ImageView
                android:id="@+id/ivScissors"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_racha_1"
                android:contentDescription="Racha badge" />

            <!-- Número grande de la racha -->
            <TextView
                android:id="@+id/tvRachaNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/oswald_font"
                android:text="0"
                android:textColor="#FF9800"
                android:textSize="80sp"
                android:textStyle="bold"
                android:lineSpacingExtra="-8dp" />

            <!-- Etiqueta dinámica -->
            <TextView
                android:id="@+id/tvRachaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/oswald_font"
                android:text="CORTES EN TU RACHA"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:letterSpacing="0.12" />

            <!-- Línea divisora naranja -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginTop="20dp"
                android:background="#FF9800" />

            <!-- Mensaje de bienvenida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/oswald_font"
                android:text="¡Bienvenido de vuelta!"
                android:textColor="#888888"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
