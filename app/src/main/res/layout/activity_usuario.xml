<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_usuario"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header naranja -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#1A1A1A"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageUsuario"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/perfil_default"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircularShape"
                        app:strokeColor="#FF9800"
                        app:strokeWidth="3dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/oswald_font"
                        android:text="MI PERFIL"
                        android:textColor="#FF9800"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Campos de info -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/oswald_font"
                                android:text="NOMBRE"
                                android:textColor="#FF9800"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/textNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/oswald_font"
                                android:text="CORREO"
                                android:textColor="#FF9800"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/textEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/oswald_font"
                                android:text="CELULAR"
                                android:textColor="#FF9800"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/textCelular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card progreso recompensa -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProgresoRecompensa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#FF9800"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="MI PROGRESO DE RECOMPENSA"
                                android:textColor="#FF9800"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textProgresoReservas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="0 de 7 reservas para tu próxima reserva gratuita"
                                android:textColor="#CCCCCC"
                                android:textSize="13sp" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressRecompensa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="#FF9800"
                                app:trackColor="#333333"
                                app:trackCornerRadius="8dp" />

                            <TextView
                                android:id="@+id/textRecompensaDisponible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/oswald_font"
                                android:text="¡Tienes una reserva gratis disponible!"
                                android:textColor="#FF9800"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonActualizarUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#FF9800"
                        android:fontFamily="@font/oswald_font"
                        android:text="ACTUALIZAR DATOS"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogoutUser"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="#B71C1C"
                        android:fontFamily="@font/oswald_font"
                        android:text="CERRAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:itemIconTint="@drawable/color_state_list"
            app:itemTextColor="@drawable/color_state_list"
            app:menu="@menu/bottom_nav_menu"
            app:itemBackground="@drawable/no_ripple_background"
            app:itemRippleColor="@android:color/transparent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
