<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:statusBarColor="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Contenido principal -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#212121"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_parte_1"> <!-- Fondo personalizado con la imagen fondo_parte_1.png -->

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagenEncimaTitulo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="Imagen encima del título"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logobarbershop"
                    android:background="@android:color/white"
                    app:shapeAppearanceOverlay="@style/CircularShape"
                    app:layout_constraintBottom_toTopOf="@+id/tituloTienda"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.501"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <TextView
                    android:id="@+id/tituloTienda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/oswald_font"
                    android:gravity="center"
                    android:text="BARBERSHOP DIAMOND"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imagenEncimaTitulo" />

                <!-- Frase debajo del título -->
                <TextView
                    android:id="@+id/subTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:fontFamily="@font/oswald_font"
                    android:gravity="center"
                    android:text="Tu mejor versión empieza aquí"
                    android:textColor="#FFA500"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toTopOf="@+id/clienteInfoLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tituloTienda" />

                <!-- Información del Cliente Nueva -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clienteInfoLayout"
                    android:layout_width="294dp"
                    android:layout_height="87dp"
                    android:background="@drawable/fondo_cliente"
                    android:padding="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/metaLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/subTitulo"
                    app:layout_constraintVertical_bias="0.5">

                    <!-- Foto del cliente en círculo -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/clienteFoto"
                        android:layout_width="63dp"
                        android:layout_height="55dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="Cliente"
                        android:scaleType="centerCrop"
                        android:src="@drawable/perfil_default"
                        app:layout_constraintBottom_toBottomOf="@id/clienteInfoLayout"
                        app:layout_constraintEnd_toStartOf="@id/textContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/clienteInfoLayout"
                        app:shapeAppearanceOverlay="@style/CircularShape" />

                    <LinearLayout
                        android:id="@+id/textContainer"
                        android:layout_width="187dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="24dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/clienteFoto"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/clienteFoto"
                        app:layout_constraintTop_toTopOf="@id/clienteFoto"
                        app:layout_constraintVertical_bias="1.0">

                        <TextView
                            android:id="@+id/clienteNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/oswald_font"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="25sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Meta del Cliente -->
                <LinearLayout
                    android:id="@+id/metaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_meta_container"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clienteInfoLayout">

                    <!-- Header: section title + counter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/oswald_font"
                            android:letterSpacing="0.08"
                            android:text="✦ RACHA DE CORTES"
                            android:textColor="#FF9800"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/metaProgresoTexto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_meta_cortes"
                            android:fontFamily="@font/oswald_font"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="0/10 Cortes"
                            android:textColor="#ffffff"
                            android:letterSpacing="0.04"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Thin separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#2D2D2D" />

                    <!-- 10 progress dots -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView android:id="@+id/rachaDot1" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot2" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot3" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot4" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot5" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot6" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot7" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot8" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot9" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_racha_dot" />
                        <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="#2D2D2D" />
                        <ImageView android:id="@+id/rachaDot10" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_racha_dot" />
                    </LinearLayout>

                    <!-- Milestone labels (aligned under dots 1, 5, 10) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1" android:textColor="#555555" android:fontFamily="@font/oswald_font" android:textSize="10sp" android:gravity="start" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5" android:textColor="#555555" android:fontFamily="@font/oswald_font" android:textSize="10sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10 ✦" android:textColor="#FF9800" android:fontFamily="@font/oswald_font" android:textSize="10sp" android:gravity="end" />
                    </LinearLayout>

                    <!-- Badge + status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <ImageView
                            android:id="@+id/metaProgresoImagen"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ic_racha_1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/metaTexto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_meta_title"
                                android:fontFamily="@font/oswald_font"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="Alcanza la meta"
                                android:textColor="#000000"
                                android:textSize="15sp"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/metaDescripcionTexto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/oswald_font"
                                android:text="Te faltan 10 cortes para\ntu recompensa"
                                android:textColor="#666666"
                                android:textSize="11sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Carrusel de promociones -->
                <!-- Eliminar el ViewPager2 -->

                <View
                    android:id="@+id/lineaNaranjaServicios"
                    android:layout_width="00dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="24dp"
                    android:background="#FF9800"
                    app:layout_constraintTop_toBottomOf="@id/metaLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Título Servicios con nuevo estilo (Fondo verde) -->
                <TextView
                    android:id="@+id/tituloServicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/oswald_font"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="— NUESTROS SERVICIOS —"
                    android:textColor="#FF9800"
                    android:textSize="17sp"
                    android:letterSpacing="0.1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lineaNaranjaServicios" />

                <!-- Scroll horizontal de botones con estilo -->
                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tituloServicios"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/serviciosButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#FF9800"
                            android:fontFamily="@font/oswald_font"
                            android:text="Todos"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cortesButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#2A2A2A"
                            android:fontFamily="@font/oswald_font"
                            android:text="Cortes"
                            android:textColor="#FF9800"
                            android:textSize="13sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="#FF9800"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/SkincareButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#2A2A2A"
                            android:fontFamily="@font/oswald_font"
                            android:text="Skincare"
                            android:textColor="#FF9800"
                            android:textSize="13sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="#FF9800"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/AfeitadoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#2A2A2A"
                            android:fontFamily="@font/oswald_font"
                            android:text="Afeitado"
                            android:textColor="#FF9800"
                            android:textSize="13sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="#FF9800"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ColoracionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#2A2A2A"
                            android:fontFamily="@font/oswald_font"
                            android:text="Coloración"
                            android:textColor="#FF9800"
                            android:textSize="13sp"
                            app:cornerRadius="20dp"
                            app:strokeColor="#FF9800"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Lista de servicios -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/horizontalScrollView"
                    tools:ignore="NotSibling" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:itemIconTint="@drawable/color_state_list"
            app:itemTextColor="@drawable/color_state_list"
            app:menu="@menu/bottom_nav_menu"
            app:itemBackground="@drawable/no_ripple_background"
            app:itemRippleColor="@android:color/transparent"/>

        <ProgressBar
            android:id="@+id/progressBarHome"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#FF9800"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
